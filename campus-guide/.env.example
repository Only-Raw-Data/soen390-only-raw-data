# Google Cloud Console -> APIs & Services -> Credentials -> API keys
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Public Overpass endpoint (for example https://overpass-api.de/api/interpreter) or your own Overpass server URL
EXPO_PUBLIC_OVERPASS_URL=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (used for Calendar auth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Run "expo whoami" while logged in to Expo and copy the returned username
EXPO_PUBLIC_EXPO_USERNAME=

# Use the "slug" value from app.config.js (must match your Expo project slug)
EXPO_PUBLIC_APP_SLUG=

# Enable Google Calendar API in Google Cloud Console
# Go on google cloud console and create 2 OAuth 2.0 Client IDs
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (used for Calendar auth)
# Select Android for first one and IOS for second one
# Find bundler in app.config.js for IOS
# Find SHA1 for android and package name in app.config.js
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# PostHog – optional (usability testing, surveys, session replay). Leave empty for local dev.
EXPO_PUBLIC_POSTHOG_API_KEY=
# PostHog host URL (e.g., https://us.i.posthog.com)
EXPO_PUBLIC_POSTHOG_HOST=
# Set to "true" to use mock GPS location for indoor navigation (useful for development/testing)
DEV_MODE_ENABLED=


