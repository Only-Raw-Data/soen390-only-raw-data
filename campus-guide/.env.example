# Google Cloud Console -> APIs & Services -> Credentials -> API keys
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Public Overpass endpoint (for example https://overpass-api.de/api/interpreter) or your own Overpass server URL
EXPO_PUBLIC_OVERPASS_URL=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (used for Calendar auth)
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=

# Run "expo whoami" while logged in to Expo and copy the returned username
EXPO_PUBLIC_EXPO_USERNAME=

# Use the "slug" value from app.config.js (must match your Expo project slug)
EXPO_PUBLIC_APP_SLUG=

