{
  "name": "campus-guide",
  "main": "expo-router/entry",
  "license": "0BSD",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:native": "expo run:android",
    "ios": "expo run:ios",
    "ios:native": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --coverage",
    "build": "expo prebuild",
    "bundle:native": "expo export --platform ios --platform android",
    "ci": "npm run test && npm run bundle:native"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "^1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native-maps": "^0.24.1",
    "babel-jest": "^29.7.0",
    "jest": "~29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["lcov", "text", "clover", "json-summary", "json"],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "constants/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/node_modules/**",
      "!**/*.config.{ts,js}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-navigation|@expo|expo)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>"
    ],
    "moduleNameMapper": {
      "^@/services/(.*)$": "<rootDir>/services/$1",
      "^@services/(.*)$": "<rootDir>/services/$1",
      "^@app/(.*)$": "<rootDir>/app/$1",
      "^@constants/(.*)$": "<rootDir>/constants/$1",
      "^@components/(.*)$": "<rootDir>/components/$1",
      "^@context/(.*)$": "<rootDir>/app/context/$1",
      "^@hooks/(.*)$": "<rootDir>/app/hooks/$1",
      "^@navigation/(.*)$": "<rootDir>/app/navigation/$1",
      "^@screens/(.*)$": "<rootDir>/app/screens/$1",
      "^@types/(.*)$": "<rootDir>/types/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
